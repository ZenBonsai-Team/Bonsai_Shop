<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>Bonsai_Shop</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Bonsai_Shop</name>
    <description>Bonsai_Shop</description>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencies>

        <!-- Web MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Thymeleaf + Security tích hợp -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- JPA / Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>

        <!-- DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Playwright E2E -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.45.0</version>
            <scope>test</scope>
        </dependency>




        <!-- Spring Boot Mail -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!--Cloudinary -->
        <dependency>
            <groupId>com.cloudinary</groupId>
            <artifactId>cloudinary-http44</artifactId>
            <version>1.39.0</version>
        </dependency>

        <!-- Flyway Database Migration -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Google OAuth2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!-- WebSocket (for Live Stream Chat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-proc:full</arg>
                    </compilerArgs>
                    <annotationProcessors>
                        <annotationProcessor>lombok.launch.AnnotationProcessorHider$AnnotationProcessor</annotationProcessor>
                    </annotationProcessors>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/RecreateDatabaseTest.java</exclude>
                        <exclude>**/DatabaseResetTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- spring-boot-maven-plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- JaCoCo -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>

                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>report-team-l1</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site/jacoco-team-l1</outputDirectory>
                            <includes>
                                <include>**/service/*Service.class</include>
                                <include>**/config/VNPayConfig.class</include>
                                <include>**/product/service/MailService.class</include>
                                <include>**/moderator/service/OrderActionService.class</include>
                                <include>**/moderator/service/OrderDetailService.class</include>
                                <include>**/moderator/service/MyOrderService.class</include>
                                <include>**/moderator/util/ModeratorDisplayLabelMapper.class</include>

                                <include>**/appointmentSetting/service/AppointmentSettingService.class</include>
                                <include>**/artisan/service/ArtisanAppointmentService.class</include>
                                <include>**/customer/service/ViewingAppointmentService.class</include>

                                <include>**/artisan/service/ArtisanProductService.class</include>
                                <include>**/artisan/service/ArtisanCatalogService.class</include>
                                <include>**/artisan/service/ArtisanInPersonOrderService.class</include>
                                <include>**/artisan/service/ProductJournalService.class</include>

                                <include>**/customer/controller/CommunityController.class</include>
                                <include>**/customer/service/ProfanityFilterService.class</include>

                                <include>**/livestream/controller/LiveStreamApiController.class</include>
                                <include>**/livestream/service/LiveStreamService.class</include>

                                <include>**/customer/service/UserService.class</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>team-l2</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>@{jacoco.l2.argLine}</argLine>
                            <excludes>
                                <exclude>**/RecreateDatabaseTest.java</exclude>
                                <exclude>**/DatabaseResetTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.15</version>
                        <executions>
                            <execution>
                                <id>prepare-agent-l2</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <destFile>${project.build.directory}/jacoco-l2.exec</destFile>
                                    <propertyName>jacoco.l2.argLine</propertyName>
                                    <append>false</append>
                                </configuration>
                            </execution>
                            <execution>
                                <id>report-team-l2</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <configuration>
                                    <dataFile>${project.build.directory}/jacoco-l2.exec</dataFile>
                                    <outputDirectory>${project.build.directory}/site/jacoco-team-l2</outputDirectory>
                                    <includes>
                                        <include>**/customer/controller/AuthController.class</include>
                                        <include>**/customer/controller/ProfileController.class</include>
                                        <include>**/customer/controller/ForgotPasswordController.class</include>
                                        <include>**/customer/controller/ChangePasswordController.class</include>
                                        <include>**/customer/controller/CartMvcController.class</include>
                                        <include>**/customer/controller/CommunityController.class</include>
                                        <include>**/customer/controller/ViewingAppointmentController.class</include>

                                        <include>**/product/controller/OrderApiController.class</include>
                                        <include>**/product/controller/PaymentController.class</include>
                                        <include>**/product/controller/IPNController.class</include>
                                        <include>**/product/controller/CartApiController.class</include>

                                        <include>**/moderator/controller/ModeratorOrderController.class</include>

                                        <include>**/artisan/controller/ArtisanAppointmentController.class</include>
                                        <include>**/artisan/controller/ArtisanInPersonOrderController.class</include>
                                        <include>**/artisan/controller/ArtisanProductController.class</include>
                                        <include>**/artisan/controller/ArtisanCatalogController.class</include>

                                        <include>**/livestream/controller/LiveStreamApiController.class</include>

                                        <include>**/artisan/scheduler/AppointmentAutoStatusScheduler.class</include>

                                        <include>**/product/service/OrderService.class</include>
                                        <include>**/product/service/OrderExpirationService.class</include>
                                        <include>**/product/service/MailService.class</include>
                                        <include>**/product/service/CartService.class</include>
                                        <include>**/finance/service/FinancialLedgerService.class</include>
                                        <include>**/config/VNPayConfig.class</include>
                                        <include>**/moderator/service/OrderActionService.class</include>
                                        <include>**/moderator/service/OrderDetailService.class</include>
                                        <include>**/moderator/service/MyOrderService.class</include>
                                        <include>**/moderator/util/ModeratorDisplayLabelMapper.class</include>
                                        <include>**/appointmentSetting/service/AppointmentSettingService.class</include>
                                        <include>**/artisan/service/ArtisanAppointmentService.class</include>
                                        <include>**/artisan/service/ArtisanCatalogService.class</include>
                                        <include>**/artisan/service/ArtisanInPersonOrderService.class</include>
                                        <include>**/artisan/service/ArtisanProductService.class</include>
                                        <include>**/artisan/service/ProductJournalService.class</include>
                                        <include>**/customer/service/ViewingAppointmentService.class</include>
                                        <include>**/customer/service/UserService.class</include>
                                        <include>**/customer/service/ProfanityFilterService.class</include>
                                        <include>**/customer/service/CustomUserDetailsService.class</include>
                                        <include>**/livestream/service/LiveStreamService.class</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
